<!DOCTYPE invoices [
  <!ELEMENT invoices (invoice+)>
  <!ELEMENT invoice (orderDate, employee, customer, shipping, payment, details, summary, note?)>
  <!ATTLIST invoice id ID #REQUIRED status (pending|confirmed|shipping|completed|cancelled) "pending">
