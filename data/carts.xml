  <!ELEMENT size (#PCDATA)>
  <!ELEMENT quantity (#PCDATA)>
  <!ELEMENT unitPrice (#PCDATA)>
  <!ELEMENT discount (#PCDATA)>
  <!ELEMENT lineTotal (#PCDATA)>
  <!ELEMENT summary (subTotal, shippingFee, total)>
  <!ATTLIST summary currency CDATA "USD">
  <!ELEMENT subTotal (#PCDATA)>
  <!ELEMENT shippingFee (#PCDATA)>
  <!ELEMENT total (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
]>
